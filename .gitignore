# Python
__pycache__/
*.py[cod]
.pytest_cache/
pytest-cache-files-*/
allure-results/
*.egg-info/
.venv/
venv/

# 编辑器 / IDE（这些是"你的机器"，不是"这个项目"）
.idea/
.vscode/
*.swp

# 输出物（工具跑出来的东西不进仓库）
out/
*.xlsx
*.png
*.err

# 密钥（永远不进仓库）
# 正确做法是环境变量；但万一有人用 .env，也必须挡住
.env
.env.*
!.env.example
*.key

# 个人工作台（状态、周记、收工清单）—— 不入库，只有项目文档才进仓库
NOTES.md
